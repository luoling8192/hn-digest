TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: allow callbacks from explicitly bound messages in this separate test channel.
# Publishing still uses TELEGRAM_CHAT_ID. Omit to disable preview bindings.
# TELEGRAM_PREVIEW_CHAT_ID=-1001234567890
# Optional: numeric Telegram user ID allowed to use private recommendations.
# Omit entirely to disable private chat and archive backfill.
# TELEGRAM_OWNER_ID=123456789
READING_ARCHIVE_TARGET=300
OPENROUTER_API_KEY=
# Required: Firecrawl is the article retrieval service; requests consume account credits.
FIRECRAWL_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MAX_OUTPUT_TOKENS=12000
TELEGRAPH_ACCESS_TOKEN=
CHANNEL_NAME=Hacker News 摘要
CHANNEL_URL=
ADMIN_TOKEN=
DATA_DIR=./data
AUTO_PUBLISH=false
MIN_SCORE=150
POLL_INTERVAL_SECONDS=600
MAX_NEW_PER_CYCLE=3
COMMENT_UPDATE_THRESHOLD=10
MAX_COMMENT_UPDATES=3
